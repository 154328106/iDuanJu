{
  "manifest": {
    "schema": 1,
    "id": "com.idj.test.animation",
    "name": "公开测试动画 M3U",
    "version": "1.0.0",
    "author": {
      "name": "iDuanJu compatibility test"
    },
    "type": "video",
    "adult": false,
    "minAppVersion": "1.5",
    "entry": "main.js",
    "permissions": {
      "http": [
        "test-streams.mux.dev"
      ],
      "media": [
        "test-streams.mux.dev"
      ]
    },
    "capabilities": [
      "home",
      "category",
      "search",
      "detail",
      "play"
    ],
    "integrity": {
      "files": {
        "main.js": "sha256-Z8jd1iVR5i0coq6oELg6hoIOM2OTTCIE7PUWaJuG310="
      }
    }
  },
  "files": {
    "main.js": "const channels = [{\"title\": \"Big Buck Bunny (Mux HLS test)\", \"group\": \"公开测试动画\", \"id\": \"1\", \"url\": \"https://test-streams.mux.dev/x36xhzz/x36xhzz.m3u8\", \"headers\": {}}];\n\nfunction find(id) { const c=channels.find(x => x.id===String(id)); if (!c) throw host.error('E_NOT_FOUND','频道不存在'); return c; }\nfunction page(items, n) { const size=50, p=Math.max(1,Number(n)||1); return {items:items.slice((p-1)*size,p*size),page:p,hasMore:p*size<items.length}; }\nexport default {\n home() { return {categories:Array.from(new Set(channels.map(x=>x.group))).map(x=>({id:x,name:x})),items:channels.slice(0,50)}; },\n category({id,page:p}) { return page(channels.filter(x=>!id||x.group===id),p); },\n search({keyword,page:p}) { return page(channels.filter(x=>x.title.toLowerCase().includes(String(keyword||'').toLowerCase())),p); },\n detail({id}) { const c=find(id); return {title:c.title,cover:c.cover,desc:'M3U 静态导入；原始内容归其权利人所有。',lines:[{name:c.group,episodes:[{id:c.id,name:c.title}]}]}; },\n play({episodeId}) { const c=find(episodeId); return {streams:[{url:c.url,headers:c.headers,format:/\\.m3u8(?:[?#]|$)/i.test(c.url)?'hls':'mp4'}]}; }\n};\n"
  }
}