[
  {
    "bookSourceUrl": "https://images-api.nasa.gov#audio",
    "bookSourceName": "NASA public audio library",
    "bookSourceType": 1,
    "bookSourceGroup": "Real public provider / audio",
    "bookSourceComment": "Independent adapter for NASA Image and Video Library public APIs. The book entry is self-owned metadata; its table of contents and audio assets are the actual remote NASA catalog. Credit NASA; no endorsement. https://www.nasa.gov/nasa-brand-center/images-and-media/",
    "enabled": true,
    "exploreUrl": "Public audio::data:application/json;base64,",
    "ruleExplore": {
      "bookList": "$.items",
      "name": "$.name",
      "author": "$.author",
      "bookUrl": "$.url"
    },
    "ruleBookInfo": {
      "name": "$.name",
      "author": "$.author",
      "intro": "$.intro",
      "tocUrl": "$.toc"
    },
    "ruleToc": {
      "chapterList": "$.collection.items",
      "chapterName": "$.data[0].title",
      "chapterUrl": "$.href@js:encodeURI(String(result).replace(/^http:/,'https:'))"
    },
    "ruleContent": {
      "content": "@js:JSON.parse(result).filter(function(u){return /~128k\\.mp3$/.test(u)}).map(function(u){return encodeURI(String(u).replace(/^http:/,'https:'))})[0]"
    }
  }
]
