  {
    "name": "rss-custom",
    "source": {
      "sourceUrl": "https://rss.example.org",
      "sourceName": "Own custom RSS fixture",
      "sortUrl": "News::/feed?page={{page}}",
      "ruleArticles": "-$.items[*]",
      "ruleTitle": "title",
      "ruleLink": "url",
      "rulePubDate": "date",
      "ruleDescription": "summary",
      "ruleNextPage": "PAGE",
      "ruleContent": "@js:rssArticle.getTitle()+'\\n'+JSON.parse(java.ajax('https://example.org/article-api')).body"
    },
    "body": "{\"items\": [{\"title\": \"Old\", \"url\": \"/old\", \"summary\": \"old summary\", \"date\": \"2026-11-17\"}, {\"title\": \"New\", \"url\": \"/new\", \"summary\": \"new summary\", \"date\": \"2026-11-18\"}]}",
    "detailBody": "{\"body\":\"<p>Full custom article.</p>\"}",
    "expectedTitles": [
      "New",
      "Old"
    ],
    "expectedLinks": [
      "https://rss.example.org/new",
      "https://rss.example.org/old"
    ],
    "expectedText": "New\nOwned API full article body.",
    "apiBody": "{\"body\": \"Owned API full article body.\"}"
  }
