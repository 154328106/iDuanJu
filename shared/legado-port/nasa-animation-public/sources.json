[
  {
    "bookSourceUrl": "https://images-api.nasa.gov",
    "bookSourceName": "NASA public animation library",
    "bookSourceType": 4,
    "bookSourceGroup": "Real public provider / scientific animation",
    "bookSourceComment": "Independent adapter for NASA Image and Video Library public APIs. Actual remote catalog/detail/asset TOC, not static data. Credit NASA/JPL-Caltech; no endorsement. https://www.nasa.gov/nasa-brand-center/images-and-media/",
    "enabled": true,
    "searchUrl": "https://images-api.nasa.gov/search?media_type=video&q={{key}}&page={{page}}&page_size=5",
    "exploreUrl": "Public animations::https://images-api.nasa.gov/search?media_type=video&q=animation&page={{page}}&page_size=5",
    "ruleSearch": {
      "bookList": "$.collection.items",
      "name": "$.data[0].title",
      "author": "$.data[0].center",
      "intro": "$.data[0].description",
      "coverUrl": "$.links[0].href",
      "bookUrl": "$.data[0].nasa_id@js:'https://images-api.nasa.gov/search?nasa_id='+encodeURIComponent(result)"
    },
    "ruleExplore": {
      "bookList": "$.collection.items",
      "name": "$.data[0].title",
      "author": "$.data[0].center",
      "intro": "$.data[0].description",
      "coverUrl": "$.links[0].href",
      "bookUrl": "$.data[0].nasa_id@js:'https://images-api.nasa.gov/search?nasa_id='+encodeURIComponent(result)"
    },
    "ruleBookInfo": {
      "name": "$.collection.items[0].data[0].title",
      "author": "$.collection.items[0].data[0].center",
      "intro": "$.collection.items[0].data[0].description",
      "coverUrl": "$.collection.items[0].links[0].href",
      "tocUrl": "$.collection.items[0].href"
    },
    "ruleToc": {
      "chapterList": "@js:JSON.parse(result).filter(function(u){return /~small\\.mp4$/.test(u)}).slice(0,1)",
      "chapterName": "@js:'Public NASA animation'",
      "chapterUrl": "@js:String(result).replace(/^http:/,'https:')"
    }
  }
]
